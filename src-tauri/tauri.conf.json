{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chatgpt-overlay-bar",
  "version": "0.2.0",
  "identifier": "com.globalvox.chatgpt-overlay-bar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "security": {
      "csp": "default-src 'none'; style-src 'self'; img-src 'self' asset:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": [
        "default"
      ]
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
